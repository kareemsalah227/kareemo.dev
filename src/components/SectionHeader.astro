---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;
const alignment = align === "center" ? "mx-auto text-center" : "";
---

<div class={`max-w-[720px] ${alignment}`.trim()}>
  {eyebrow && <p class="section-eyebrow mb-3 text-accent-contrast">{eyebrow}</p>}
  <h2 class="text-[2rem] leading-[1.08] md:text-[2.4rem]">{title}</h2>
  {description && <p class="mt-4">{description}</p>}
</div>
