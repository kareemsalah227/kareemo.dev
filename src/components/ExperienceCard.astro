---
import Card from "./Card.astro";
import Tag from "./Tag.astro";

interface Props {
  role: string;
  company: string;
  dates: string;
  summary: string;
  impacts: string[];
  tech: string[];
}

const { role, company, dates, summary, impacts, tech } = Astro.props;
---

<Card className="flex h-full flex-col gap-5 p-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">{dates}</p>
      <h3 class="mt-2 text-[1.45rem] leading-[1.12]">{role}</h3>
      <p class="mt-1 text-text">{company}</p>
    </div>
    <a class="title-link text-sm font-medium text-accent" href="/work">
      Full work page
    </a>
  </div>
  <p>{summary}</p>
  <ul class="space-y-2 text-sm leading-6 text-muted">
    {impacts.map((impact) => <li>• {impact}</li>)}
  </ul>
  <div class="mt-auto flex flex-wrap gap-2">
    {tech.map((item) => <Tag>{item}</Tag>)}
  </div>
</Card>
