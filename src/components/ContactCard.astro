---
import Card from "./Card.astro";
import Button from "./Button.astro";

interface Props {
  label: string;
  detail: string;
  href?: string;
  actionLabel?: string;
  description?: string;
  external?: boolean;
}

const {
  label,
  detail,
  href,
  actionLabel,
  description,
  external = false,
} = Astro.props;
---

<Card className="p-5">
  <div class="space-y-3">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">{label}</p>
    <p class="mt-3 text-base text-text">{detail}</p>
    {description && <p class="text-sm">{description}</p>}
    {href && actionLabel && (
      <div class="pt-1">
        <Button href={href} variant="secondary" size="sm" external={external}>
          {actionLabel}
        </Button>
      </div>
    )}
  </div>
</Card>
