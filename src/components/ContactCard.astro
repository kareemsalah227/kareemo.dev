---
import Card from "./Card.astro";

interface Props {
  label: string;
  href: string;
  detail: string;
  external?: boolean;
}

const { label, href, detail, external = false } = Astro.props;
---

<Card className="p-5">
  <a
    href={href}
    class="block"
    target={external ? "_blank" : undefined}
    rel={external ? "noreferrer" : undefined}
  >
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">{label}</p>
    <p class="mt-3 text-base text-text">{detail}</p>
  </a>
</Card>
