---
import { siteConfig } from "../data/site";
---

<footer class="border-t border-border/80 py-10">
  <div class="container-shell flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="max-w-[30rem]">
      <p class="text-sm text-muted">© 2026 {siteConfig.name}. Built with care.</p>
    </div>

    <div class="flex flex-col gap-3 text-sm">
      <a class="title-link" href={`mailto:${siteConfig.email}`}>
        {siteConfig.email}
      </a>
      {siteConfig.socialLinks.map((link) => (
        <a class="title-link" href={link.href} target="_blank" rel="noreferrer">
          {link.label}
        </a>
      ))}
      <a class="title-link" href="/privacy">
        Privacy
      </a>
      <!-- <a class="title-link" href={siteConfig.resumeHref}>
        Resume
      </a> -->
    </div>
  </div>
</footer>
